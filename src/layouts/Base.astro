---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
}

const { title, description, path } = Astro.props;
const site = Astro.site ?? new URL('https://agentuxos.org');
const canonical = new URL(path, site).href;
const ogImage = new URL('/brand/social-1280x640.png', site).href;
const gh = 'https://github.com/agentux-os';
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0b0d10" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/icon-256.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AgentUX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="AgentUX: the Linux distribution where every coding agent works as one team." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Martian+Mono:wdth,wght@87.5,400;87.5,500;100,700&display=swap"
    />

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href="/" aria-label="AgentUX home">
          <img class="lockup lockup-dark" src="/brand/lockup-dark.svg" alt="AgentUX" width="160" height="26" />
          <img class="lockup lockup-light" src="/brand/lockup-light.svg" alt="" width="160" height="26" />
        </a>
        <nav class="site-nav" aria-label="Main">
          <a href="/#how" class="hide-sm">How it works</a>
          <a href="/#docs" class="hide-sm">Docs</a>
          <a href={`${gh}`}>GitHub</a>
          <a href="/download/" class="nav-cta" aria-current={path === '/download/' ? 'page' : undefined}>Download</a>
          <button class="theme-toggle" type="button" aria-label="Switch to light theme" data-theme-toggle>
            <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.6A8.2 8.2 0 0 1 9.4 4a8.2 8.2 0 1 0 10.6 10.6z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <img class="mark mark-dark" src="/brand/mark-compact-lime.svg" alt="" width="40" height="40" />
          <img class="mark mark-light" src="/brand/mark-compact-moss.svg" alt="" width="40" height="40" />
          <p>AgentUX is free software under the <a href="https://github.com/agentux-os/agentux/blob/main/LICENSE">Apache License 2.0</a>. Pre-release: expect rough edges.</p>
        </div>
        <nav aria-label="Repositories">
          <h2 class="footer-h">Source</h2>
          <ul>
            <li><a href={`${gh}/agentux`}>agentux</a></li>
            <li><a href={`${gh}/agentux-core`}>agentux-core</a></li>
            <li><a href={`${gh}/agentux-desktop`}>agentux-desktop</a></li>
            <li><a href={`${gh}/agentux-os`}>agentux-os</a></li>
            <li><a href={`${gh}/agentux-os.github.io`}>This website</a></li>
          </ul>
        </nav>
        <nav aria-label="Project">
          <h2 class="footer-h">Project</h2>
          <ul>
            <li><a href="/download/">Download</a></li>
            <li><a href={`${gh}/agentux/blob/main/docs/getting-started.md`}>Getting started</a></li>
            <li><a href={`${gh}/agentux/tree/main/docs/adr`}>Design decisions</a></li>
            <li><a href={`${gh}/agentux-os/releases`}>Releases</a></li>
            <li><a href={`${gh}/agentux-os/issues`}>Report a problem</a></li>
          </ul>
        </nav>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.querySelector('[data-theme-toggle]');
        if (!btn) return;
        var root = document.documentElement;
        function sync() {
          var dark = root.dataset.theme !== 'light';
          btn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', dark ? '#0b0d10' : '#f4f5f7');
        }
        sync();
        btn.addEventListener('click', function () {
          root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
          try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
          sync();
        });
      })();
    </script>
  </body>
</html>
